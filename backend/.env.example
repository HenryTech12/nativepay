# Copy this file to .env and fill in real values. Never commit .env.

# Speech-to-text + intent parsing: OpenAI is the primary provider,
# Groq is the automatic fallback (used whenever OPENAI_API_KEY is unset,
# or a live OpenAI call fails — outage, rate limit, timeout). See
# app/services/ai_provider.py. Set at least one of these two keys —
# ideally both, so a real OpenAI outage doesn't take voice input down
# with it.
OPENAI_API_KEY=sk-your_key_here
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe   # override if needed; default is gpt-4o-transcribe
# OPENAI_INTENT_MODEL=gpt-5-mini                 # override if needed; default is gpt-5-mini
GROQ_API_KEY=gsk_your_key_here

BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=your_bmoni_sandbox_key_here
# One-time: POST /api/bmoni/generate-owner-wallet, then paste its
# privateKey here. This is the self-custodied wallet owner key used to
# sign BMONI's owner-proof challenge for every onboarded user.
BMONI_OWNER_PRIVATE_KEY=

VOICE_MATCH_THRESHOLD=0.85

# YarnGPT — Nigerian-accented text-to-speech for the read-back/confirmation
# voice. Without a key, /api/tts fails and the frontend falls back to the
# browser's built-in speechSynthesis.
YARNGPT_API_KEY=
YARNGPT_BASE_URL=https://api.yarngpt.ai/api/v1

# Optional. Set this to a Postgres connection string (e.g. Render's
# managed Postgres) and accounts/face/voice data persist across restarts
# instead of living only in memory — see app/services/db.py. Leave blank
# for local dev; nothing else changes when it's unset.
DATABASE_URL=

# --- Production/security settings (see app/services/config.py) ---------

# "development" (default) or "production". Setting this to "production"
# turns on stricter behavior: DATABASE_URL becomes mandatory (refuses to
# boot on in-memory storage), FRONTEND_ORIGIN becomes mandatory (no
# wildcard CORS), REQUIRE_AUTH defaults on, and the client-asserted face
# fallback in /api/transactions/verify-face is disabled outright.
ENVIRONMENT=development

# The deployed frontend's origin (e.g. https://app.nativepay.example) —
# required when ENVIRONMENT=production; used as the sole allowed CORS
# origin instead of "*".
FRONTEND_ORIGIN=

# "true"/"false". Defaults to true in production, false otherwise.
# When on, /api/session/start (after a real face match) is required
# before touching account/transaction endpoints, and a session may only
# access its own userId's data.
REQUIRE_AUTH=

# Shared secret for POS-agent/BMONI-admin-only routes (account
# registration/lookup, everything under /api/bmoni/* and /api/agent/*).
# Leave blank to leave those routes open (current hackathon-demo
# behavior); set it and pass the same value as the X-Agent-Key header.
AGENT_API_KEY=

# How long (seconds) a customer session/transaction stays valid.
SESSION_TTL_SECONDS=1800
TRANSACTION_TTL_SECONDS=300
