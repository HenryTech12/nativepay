# Copy this file to .env and fill in real values. Never commit .env.

GROQ_API_KEY=gsk_your_key_here

BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=your_bmoni_sandbox_key_here
# One-time: POST /api/bmoni/generate-owner-wallet, then paste its
# privateKey here. This is the self-custodied wallet owner key used to
# sign BMONI's owner-proof challenge for every onboarded user.
BMONI_OWNER_PRIVATE_KEY=

VOICE_MATCH_THRESHOLD=0.85

# YarnGPT — Nigerian-accented text-to-speech for the read-back/confirmation
# voice. Without a key, /api/tts fails and the frontend falls back to the
# browser's built-in speechSynthesis.
YARNGPT_API_KEY=
YARNGPT_BASE_URL=https://yarngpt.ai/api/v1

# Paystack — real Nigerian bank account name-enquiry for the recipient
# lookup (resolve-recipient). A test-mode key (sk_test_...) only resolves
# Paystack's documented test account numbers, not arbitrary real ones —
# use a live key (sk_live_...) if you want it to work for real accounts.
PAYSTACK_SECRET_KEY=

# Optional. Set this to a Postgres connection string (e.g. Render's
# managed Postgres) and accounts/face/voice data persist across restarts
# instead of living only in memory — see app/services/db.py. Leave blank
# for local dev; nothing else changes when it's unset.
DATABASE_URL=
